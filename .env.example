# API origin only (no /api). Requests go to <origin>/api/tenant/<tenantId>/...
# Android emulator reaches the host machine at 10.0.2.2; iOS simulator / web use localhost.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Tenant a fresh install signs in to (next-boilerplate tenantId). Required.
EXPO_PUBLIC_DEFAULT_TENANT_ID=
EXPO_PUBLIC_APP_NAME=Boilerplate
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_FRONTEND_URL=http://localhost:3000
# EAS project UUID (`eas init`): Expo push tokens are issued for it. Push stays off while it is empty.
# app.config.ts also reads it into extra.eas.projectId; EAS_PROJECT_ID is accepted there as an alias.
EXPO_PUBLIC_EAS_PROJECT_ID=
EAS_PROJECT_ID=
# Passkeys (Phase 11, development build only). Hostname of the relying party, no scheme/port/path: the host that
# serves /.well-known/assetlinks.json and /.well-known/apple-app-site-association, equal to the server's
# WEBAUTHN_RP_ID. Empty = passkey sign-in and registration stay hidden. Also written into the iOS
# `webcredentials:<host>` associated domain by app.config.ts.
EXPO_PUBLIC_PASSKEY_RP_ID=
# Optional per-build app identifiers (defaults are the ones already in app.config.ts). The server must list the
# same ones: MOBILE_ANDROID_PACKAGE_NAME (+ MOBILE_ANDROID_CERT_SHA256) and MOBILE_IOS_APP_IDS=<TeamID>.<bundle id>.
EXPO_PUBLIC_ANDROID_PACKAGE=
EXPO_PUBLIC_IOS_BUNDLE_ID=
# Deep links (phase 6 SSO return, phase 7 invitation e-mail links).
# URL scheme of the app (default expoboilerplate). The native SSO return is `<scheme>://auth/callback`; list the EXACT
# value the app sends (log line "SSO start refused" prints it) in the server's SSO_DEVICE_REDIRECT_URIS, e.g.
# SSO_DEVICE_REDIRECT_URIS=expoboilerplate://auth/callback (add exp://<host>:8081/--/auth/callback for Expo Go).
EXPO_PUBLIC_APP_SCHEME=
# Host(s) that serve the server's /.well-known/assetlinks.json and /.well-known/apple-app-site-association (comma
# separated, hostnames only) - the host(s) in the e-mailed /auth/invitation/* links. Empty = the https links keep opening
# the browser; only the custom scheme works. Written as iOS `applinks:<host>` and an Android autoVerify intent filter.
# The server must list this app: MOBILE_ANDROID_PACKAGE_NAME + MOBILE_ANDROID_CERT_SHA256 and MOBILE_IOS_APP_IDS.
EXPO_PUBLIC_ASSOCIATED_DOMAIN=
